extends SceneTree

func _initialize() -> void:
	call_deferred("_exercise")

func _exercise() -> void:
	var game: Node = load("res://scenes/bootstrap.tscn").instantiate()
	root.add_child(game)
	game.start_button.pressed.emit()
	game._choose("pilot")
	assert(not game.state.flags.get("pilot_joined", false))
	game._choose("accept")
	game._choose("pilot")
	assert(game.state.flags["pilot_joined"])
	assert(game.message.text.begins_with("Кормчая"))
	var slot := "pilot-test-%d" % Time.get_ticks_usec()
	assert(game._save_slot(slot) and game._load_slot(slot))
	assert(game.state.flags["pilot_joined"])
	assert(game._travel("pier_to_landing"))
	game._choose("note")
	assert(game.state.flags["clue"])
	assert(game._travel("landing_to_pier"))
	assert(game._travel("pier_to_hideout"))
	game._choose("seal")
	assert(game.state.flags["quest_resolved"] and not game.state.flags["passage_open"])
	assert(game._travel("hideout_to_pier"))
	assert(game._travel("pier_to_landing"))
	game._claim_landing()
	assert(game.state.settlement["owned"])
	game._begin_voyage()
	assert(game.voyage.has_pilot)
	assert(game.message.text.contains("Кормчая"))
	game._steer(Vector2i.RIGHT)
	game._steer(Vector2i.RIGHT)
	game._steer(Vector2i.UP)
	assert(game.voyage.position == Vector2(4, 3))
	for step in 3:
		game._steer(Vector2i.RIGHT)
	assert(game.voyage.can_board())
	game._finish_voyage("negotiated")
	assert(game.voyage == null and game.state.flags.get("voyage_negotiated", false))
	assert(game._save_slot(slot) and game._load_slot(slot))
	assert(game.state.flags["voyage_complete"] and game.state.flags["pilot_joined"])
	print("PASS: pilot companion, alternate hints, ford crossing and saved outcome")
	quit()
