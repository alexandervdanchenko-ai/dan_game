extends SceneTree

func _initialize() -> void:
	call_deferred("_exercise")

func _exercise() -> void:
	var game: Node = load("res://scenes/bootstrap.tscn").instantiate()
	root.add_child(game)
	game.start_button.pressed.emit()
	assert(game._travel("pier_to_forest"))
	assert(game.state.current_location == "forest")
	game._read_forest_marks()
	assert(game._travel("forest_to_pier"))
	game._choose("accept")
	game._choose("ward")
	assert(game._travel("pier_to_landing"))
	game._choose("invoke")
	assert(game.state.flags["ward_used"])
	assert(game._travel("landing_to_pier"))
	assert(game._travel("pier_to_hideout"))
	game._choose("open")
	game._choose("seal")
	assert(game.state.flags["passage_open"])
	assert(game._travel("hideout_to_pier"))
	assert(game._travel("pier_to_landing"))
	game._claim_landing()
	game._commission("dock")
	game._toggle_reeve()
	game._next_day()
	var slot := "chapter-test-%d" % Time.get_ticks_usec()
	assert(game._save_slot(slot) and game._load_slot(slot))
	assert(game.state.settlement["construction"]["project_id"] == "dock")
	assert(game.roster.active_ids() == ["hero"])
	game._next_day()
	assert(game.state.settlement["buildings"].has("dock"))
	game._begin_voyage()
	assert(game.voyage.cargo == 1)
	game._steer(Vector2i.RIGHT)
	game._steer(Vector2i.RIGHT)
	game._steer(Vector2i.UP)
	assert(game.voyage.position == Vector2(4, 4))
	for step in 2:
		game._steer(Vector2i.RIGHT)
	game._begin_boarding()
	assert(game.combat.active_members == ["hero"])
	game._order_attack()
	game._toggle_combat_pause()
	for frame in 900:
		game._physics_process(1.0 / 60.0)
	assert(game.voyage == null and game.state.flags.get("voyage_victory", false))
	assert(game.state.inventory["iron"] == 5)
	assert(game._save_slot(slot) and game._load_slot(slot))
	game._begin_voyage()
	assert(game.voyage == null and game.state.inventory["iron"] == 5)
	print("PASS: ward, settlement, construction reload, shallows, boarding and persistent reward")
	quit()
